# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI learning helper
# Set AI_PROVIDER to either "gemini" or "claude", then fill in the matching key.
AI_PROVIDER=gemini

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Claude provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Trainer admin report email notifications
# Fill these from the exact Truehost mailbox settings.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_REPORT_EMAIL=
